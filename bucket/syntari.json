{
    "version": "latest",
    "description": "Private on-device meeting synthesizer",
    "homepage": "https://github.com/strike007-3000/Syntari",
    "license": "MIT",
    "url": "https://github.com/strike007-3000/Syntari/releases/download/windows-latest/Syntari-windows.exe",
    "installer": {
        "script": "Start-Process \"$dir\\$fname\" -ArgumentList '/S' -Wait"
    },
    "uninstaller": {
        "script": "$u = \"$env:LOCALAPPDATA\\Syntari\\uninstall.exe\"; if (Test-Path $u) { Start-Process $u -ArgumentList '/S' -Wait }"
    }
}
